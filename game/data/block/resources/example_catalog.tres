[gd_resource type="Resource" script_class="AstraeonBlockCatalog" load_steps=14 format=3]

[ext_resource type="Script" path="res://game/data/block/gdscript/block_catalog.gd" id="1"]
[ext_resource type="Script" path="res://game/data/block/gdscript/block_definition.gd" id="2"]
[ext_resource type="Script" path="res://game/data/block/gdscript/block_state_definition.gd" id="3"]

[ext_resource type="Resource" path="res://game/shading/blocks/resources/stone.tres" id="stone"]
[ext_resource type="Resource" path="res://game/shading/blocks/resources/lamp.tres" id="lamp"]
[ext_resource type="Resource" path="res://game/shading/blocks/resources/log.tres" id="log"]

[sub_resource type="Resource" id="Air"]
script = ExtResource("2")
key = &"astraeon_air"
display_name = "空气"
hardness = 0.0
collision_enabled = false
light_opacity = 0

[sub_resource type="Resource" id="Stone"]
script = ExtResource("2")
key = &"astraeon_stone"
appearance = ExtResource("stone")
display_name = "石头"
hardness = 1.5

[sub_resource type="Resource" id="Lamp"]
script = ExtResource("2")
key = &"astraeon_lamp"
appearance = ExtResource("lamp")
display_name = "发光方块"
light_emission = 15

[sub_resource type="Resource" id="AxisX"]
script = ExtResource("3")
key = &"axis_x"
orientation = Basis(0, 1, 0, -1, 0, 0, 0, 0, 1)
properties = Dictionary[StringName, StringName]({&"axis": &"x"})

[sub_resource type="Resource" id="AxisY"]
script = ExtResource("3")
key = &"axis_y"
properties = Dictionary[StringName, StringName]({&"axis": &"y"})

[sub_resource type="Resource" id="AxisZ"]
script = ExtResource("3")
key = &"axis_z"
orientation = Basis(1, 0, 0, 0, 0, -1, 0, 1, 0)
properties = Dictionary[StringName, StringName]({&"axis": &"z"})

[sub_resource type="Resource" id="Log"]
script = ExtResource("2")
key = &"astraeon_log"
appearance = ExtResource("log")
display_name = "原木"
hardness = 2.0
default_state = &"axis_y"
states = Array[ExtResource("3")]([SubResource("AxisX"), SubResource("AxisY"), SubResource("AxisZ")])

[resource]
script = ExtResource("1")
definitions = Array[ExtResource("2")]([SubResource("Air"), SubResource("Stone"), SubResource("Lamp"), SubResource("Log")])
