+void VoxelTerrain::process_circular_viewer(const PairedViewer &viewer, bool can_load_blocks) {
+    const PairedViewer::State &old_state = viewer.prev_state;
+    const PairedViewer::State &new_state = viewer.state;
+    const bool flags_changed = old_state.requires_meshes != new_state.requires_meshes ||
+            old_state.requires_collisions != new_state.requires_collisions;
+    if (old_state.data_box == new_state.data_box && old_state.mesh_box == new_state.mesh_box &&
+            old_state.circular_center == new_state.circular_center &&
+            old_state.circular_radius == new_state.circular_radius && !flags_changed) return;
+    if (old_state.data_box != new_state.data_box) {
+        Ref<VoxelGenerator> generator = get_generator();
+        if (generator.is_valid()) generator->process_viewer_diff(viewer.id, new_state.data_box, old_state.data_box);
+    }
+    // Iterate old and new spans separately on teleport, avoiding work proportional to travel distance.
+    auto each_row = [](Box3i previous, Box3i next, auto callback) {
+        for (int z = previous.position.z; z < previous.position.z + previous.size.z; ++z) callback(z);
+        for (int z = next.position.z; z < next.position.z + next.size.z; ++z) {
+            if (z < previous.position.z || z >= previous.position.z + previous.size.z) callback(z);
+        }
+    };
+    each_row(old_state.data_box, new_state.data_box, [&](int z) {
+        const int old_padding = (old_state.requires_meshes || old_state.requires_collisions) ? 1 : 0;
+        const int new_padding = (new_state.requires_meshes || new_state.requires_collisions) ? 1 : 0;
+        const Box3i previous = circular_row(old_state.data_box, old_state.circular_center, old_state.circular_radius, old_padding, z);
+        const Box3i next = circular_row(new_state.data_box, new_state.circular_center, new_state.circular_radius, new_padding, z);
+        if (previous != next) process_viewer_data_box_change(viewer.id, previous, next, can_load_blocks, false);
+    });
+    each_row(old_state.mesh_box, new_state.mesh_box, [&](int z) {
+        const Box3i previous = circular_row(old_state.mesh_box, old_state.circular_center, old_state.circular_radius, 0, z);
+        const Box3i next = circular_row(new_state.mesh_box, new_state.circular_center, new_state.circular_radius, 0, z);
+        if (previous != next) {
+            previous.difference(next, [&](Box3i box) {
+                box.for_each_cell([&](Vector3i pos) {
+                    unview_mesh_block(pos, old_state.requires_meshes, old_state.requires_collisions);
+                });
+            });
+            next.difference(previous, [&](Box3i box) {
+                box.for_each_cell([&](Vector3i pos) {
+                    view_mesh_block(pos, new_state.requires_meshes, new_state.requires_collisions);
+                });
+            });
+        }
+        if (flags_changed) previous.clipped(next).for_each_cell([&](Vector3i pos) {
+            if (old_state.requires_meshes != new_state.requires_meshes) {
+                if (new_state.requires_meshes) view_mesh_block(pos, true, false);
+                else unview_mesh_block(pos, true, false);
+            }
+            if (old_state.requires_collisions != new_state.requires_collisions) {
+                if (new_state.requires_collisions) view_mesh_block(pos, false, true);
+                else unview_mesh_block(pos, false, true);
+            }
+        });
+    });
+}
