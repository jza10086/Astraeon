+// Disjoint one-Z-row boxes keep the upstream refcount, generation, saving and mesh pipeline.
+// Doubled block-center distances avoid floating point boundary differences. Data rows are
+// the exact one-block Chebyshev dilation of the mesh disk, providing all 26 mesh neighbors.
+static Box3i circular_row(Box3i box, Vector3i center, int radius, int padding, int z) {
+    if (box.size.x <= 0 || box.size.y <= 0 || box.size.z <= 0 ||
+            z < box.position.z || z >= box.position.z + box.size.z) return Box3i();
+    const int dz = math::max(math::abs(2 * (z - center.z) + 1) - 2 * padding, 1);
+    const int64_t rr = int64_t(2 * radius) * (2 * radius);
+    int first = box.position.x + box.size.x;
+    int last = box.position.x - 1;
+    for (int x = box.position.x; x < box.position.x + box.size.x; ++x) {
+        const int dx = math::max(math::abs(2 * (x - center.x) + 1) - 2 * padding, 1);
+        if (int64_t(dx) * dx + int64_t(dz) * dz <= rr) {
+            first = math::min(first, x);
+            last = x;
+        }
+    }
+    if (last < first) return Box3i();
+    return Box3i(Vector3i(first, box.position.y, z), Vector3i(last - first + 1, box.size.y, 1));
+}
